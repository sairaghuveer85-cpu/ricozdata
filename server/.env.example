# MongoDB Connection (MongoDB Atlas in Production, Local in Development)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ricozdata?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Client Origin(s) for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# JWT Secret Key (Use a strong random 256-bit string in Production)
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
